{
  "datasets": [
    {
      "name": "ds_fato_vendas",
      "displayName": "Fato de Vendas",
      "queryLines": [
        "SELECT pedido_id, data_pedido, ano, segmento, cidade, canal, marca, categoria, receita AS receita_item, margem AS margem_item ",
        "FROM fato_vendas"
      ],
      "columns": [
        {"displayName": "Receita", "description": "Receita líquida (inclui devolução negativa).", "expression": "SUM(`receita_item`)"},
        {"displayName": "Margem", "description": "Receita menos custo do produto.", "expression": "SUM(`margem_item`)"},
        {"displayName": "Pedidos", "description": "Número de pedidos distintos.", "expression": "COUNT(DISTINCT `pedido_id`)"},
        {"displayName": "Ticket Médio", "description": "Receita dividida pelo número de pedidos distintos.", "expression": "SUM(`receita_item`) / COUNT(DISTINCT `pedido_id`)"},
        {"displayName": "Margem %", "description": "Margem como percentual da receita.", "expression": "SUM(`margem_item`) * 100.0 / SUM(`receita_item`)"}
      ]
    },
    {
      "name": "ds_top_clientes",
      "displayName": "Top 20 Clientes",
      "queryLines": [
        "SELECT razao_social, segmento, cidade, ROUND(SUM(receita), 2) AS receita ",
        "FROM fato_vendas ",
        "GROUP BY razao_social, segmento, cidade ",
        "ORDER BY receita DESC ",
        "LIMIT 20"
      ]
    },
    {
      "name": "ds_fila_semanal",
      "displayName": "Fila da Semana",
      "queryLines": [
        "SELECT vendedor, ordem, razao_social, cidade, score, faixa, motivo, sugestao ",
        "FROM fila_semanal"
      ]
    }
  ],
  "pages": [
